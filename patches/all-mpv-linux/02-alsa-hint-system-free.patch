+
+// ALSA allocates hint strings with the system allocator, while this library
+// may be built with a bundled allocator (mimalloc) that also provides free().
+// Freeing ALSA-allocated strings with the bundled free() corrupts the heap,
+// so resolve the real libc free() explicitly.
+static void alsa_hint_free(void *ptr)
+{
+    // RTLD_DEFAULT resolves in load order starting from the main program.
+    // This library is loaded privately (RTLD_LOCAL), so its own bundled
+    // free() is never in the global scope and this always finds libc's.
+    void (*system_free)(void *) = dlsym(RTLD_DEFAULT, "free");
+    if (system_free) {
+        system_free(ptr);
+    } else {
+        // Should never happen (libc is always loaded); fall back instead
+        // of leaking.
+        free(ptr);
+    }
 }
 
